# Enforce consistent line endings in the repository
# Treat all files as text where Git can detect text and normalize them to LF in the repo
* text=auto

# Ensure important repo metadata use LF in the repository
.gitattributes text eol=lf
.gitignore text eol=lf

# You can add overrides for binary files if needed, for example:
# *.png binary
# *.jpg binary
